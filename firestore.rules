rules_version = '2';

// חטיבת כרמלי — מערכת טיפולים (פיילוט, ללא Auth)
// פרסמו קובץ זה ב-Firebase Console → Firestore → Rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidShift(data) {
      return data.keys().hasAll([
          'doctorName', 'treatmentType', 'date', 'startTime', 'endTime', 'slotDuration'
        ])
        && data.doctorName is string
        && data.treatmentType is string
        && data.date is string
        && data.startTime is string
        && data.endTime is string
        && data.slotDuration is int
        && (!('notes' in data) || data.notes is string)
        && (!('breaks' in data) || data.breaks is list);
    }

    function isSoldierRegistration(data) {
      return data.personalNumber is string
        && data.idNumber is string
        && data.battalion is string
        && data.fullName is string
        && data.phone is string
        && data.email is string;
    }

    match /shifts/{shiftId} {
      allow read: if true;
      allow create: if isValidShift(request.resource.data);
      allow update: if isValidShift(request.resource.data);
      allow delete: if true;

      match /appointments/{appointmentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['startTime', 'endTime', 'status'])
          && request.resource.data.status == 'available'
          && request.resource.data.startTime is string
          && request.resource.data.endTime is string;
        allow delete: if true;
        allow update: if
          (resource.data.status == 'available'
            && request.resource.data.status == 'booked'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status', 'personalNumber', 'idNumber', 'battalion',
                  'fullName', 'phone', 'email', 'bookedAt'
                ])
            && isSoldierRegistration(request.resource.data))
          || (resource.data.status == 'booked'
            && request.resource.data.status == 'booked'
            && request.resource.data.startTime == resource.data.startTime
            && request.resource.data.endTime == resource.data.endTime
            && isSoldierRegistration(request.resource.data))
          || (resource.data.status == 'booked'
            && request.resource.data.status == 'available'
            && request.resource.data.startTime == resource.data.startTime
            && request.resource.data.endTime == resource.data.endTime
            && request.resource.data.keys().hasOnly(['startTime', 'endTime', 'status']));
      }
    }
  }
}
